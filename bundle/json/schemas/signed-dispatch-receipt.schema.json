{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SignedDispatchReceipt",
  "type": "object",
  "required": [
    "artifact_type",
    "artifact_version",
    "receipt_id",
    "ledger_id",
    "sequence",
    "reservation_id",
    "authorization_id",
    "transition",
    "state",
    "replayed",
    "occurred_at",
    "binding",
    "execution_nonce",
    "approval_nonce",
    "idempotency_key",
    "budget",
    "envelope_digest",
    "ledger_event_digest",
    "integrity",
    "signature"
  ],
  "properties": {
    "artifact_type": {
      "const": "signed_dispatch_receipt"
    },
    "artifact_version": {
      "const": "0.9"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "ledger_id": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "reservation_id": {
      "type": "string",
      "minLength": 1
    },
    "authorization_id": {
      "type": "string",
      "minLength": 1
    },
    "transition": {
      "enum": [
        "authorized_to_reserved",
        "reserved_to_dispatched",
        "reserved_to_released"
      ]
    },
    "state": {
      "enum": [
        "reserved",
        "dispatched",
        "released"
      ]
    },
    "replayed": {
      "type": "boolean"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "binding": {
      "type": "object"
    },
    "execution_nonce": {
      "type": "string",
      "minLength": 1
    },
    "approval_nonce": {
      "type": [
        "string",
        "null"
      ]
    },
    "idempotency_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "budget": {
      "type": [
        "object",
        "null"
      ]
    },
    "envelope_digest": {
      "type": "string",
      "minLength": 1
    },
    "ledger_event_digest": {
      "type": "string",
      "minLength": 1
    },
    "integrity": {
      "type": "object",
      "required": [
        "algorithm",
        "digest"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "digest": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "signature": {
      "type": "object",
      "required": [
        "algorithm",
        "key_id",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "ed25519"
        },
        "key_id": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

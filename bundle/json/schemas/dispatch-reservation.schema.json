{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DispatchReservation",
  "type": "object",
  "required": [
    "artifact_type",
    "artifact_version",
    "ledger_id",
    "sequence",
    "reservation_id",
    "authorization_id",
    "execution_nonce",
    "approval_nonce",
    "idempotency_key",
    "envelope_digest",
    "state",
    "replayed",
    "reserved_at",
    "updated_at",
    "expires_at",
    "terminal_reason",
    "binding",
    "budget",
    "integrity"
  ],
  "properties": {
    "artifact_type": {
      "const": "dispatch_reservation"
    },
    "artifact_version": {
      "const": "0.9"
    },
    "ledger_id": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "reservation_id": {
      "type": "string",
      "minLength": 1
    },
    "authorization_id": {
      "type": "string",
      "minLength": 1
    },
    "execution_nonce": {
      "type": "string",
      "minLength": 1
    },
    "approval_nonce": {
      "type": [
        "string",
        "null"
      ]
    },
    "idempotency_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "envelope_digest": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "reserved",
        "dispatched",
        "released"
      ]
    },
    "replayed": {
      "type": "boolean"
    },
    "reserved_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "terminal_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "binding": {
      "type": "object"
    },
    "budget": {
      "type": [
        "object",
        "null"
      ]
    },
    "integrity": {
      "type": "object",
      "required": [
        "algorithm",
        "digest"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "digest": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

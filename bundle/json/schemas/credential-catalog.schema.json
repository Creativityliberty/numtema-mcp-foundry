{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.numtema.dev/foundry/credential-catalog.schema.json",
  "title": "CredentialCatalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "artifact_version", "accounts"],
  "properties": {
    "artifact_type": {"const": "credential_catalog"},
    "artifact_version": {"const": "0.7"},
    "accounts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "credential_handle", "auth_ref", "provider_ref", "provider_account_ref", "subject_ref", "mode", "status", "granted_scopes"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "credential_handle": {"type": "string", "minLength": 1},
          "auth_ref": {"type": "string", "minLength": 1},
          "provider_ref": {"type": "string", "minLength": 1},
          "provider_account_ref": {"type": "string", "minLength": 1},
          "subject_ref": {"type": "string", "minLength": 1},
          "client_ref": {"type": "string", "minLength": 1},
          "workspace_ref": {"type": "string", "minLength": 1},
          "mode": {"enum": ["none", "api_key", "bearer", "basic", "hmac", "oauth2_1", "host_managed"]},
          "status": {"enum": ["active", "expired", "revoked", "disabled"]},
          "granted_scopes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "audiences": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "expires_at": {"type": "string", "format": "date-time"},
          "secret_locator": {"type": "string", "minLength": 1},
          "metadata": {"type": "object"}
        }
      }
    },
    "integrity": {"type": "object", "required": ["algorithm", "digest"], "properties": {"algorithm": {"const": "sha256"}, "digest": {"type": "string"}}}
  }
}

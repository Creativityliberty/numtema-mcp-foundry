{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://numtema.dev/schemas/foundry-init-report.schema.json",
  "title": "FoundryInitReport",
  "type": "object",
  "required": ["artifact_type", "artifact_version", "project_name", "directory", "created_files", "next_commands"],
  "properties": {
    "artifact_type": { "const": "foundry_init_report" },
    "artifact_version": { "const": "0.8.1" },
    "project_name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "directory": { "type": "string", "minLength": 1 },
    "created_files": { "type": "array", "minItems": 5, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "next_commands": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  },
  "additionalProperties": false
}

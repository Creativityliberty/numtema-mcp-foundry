{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.numtema.dev/foundry/tool-catalog.schema.json",
  "title": "ToolCatalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "artifact_version", "summary", "domains"],
  "properties": {
    "artifact_type": { "const": "tool_catalog" },
    "artifact_version": { "const": "1.0" },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["tool_count", "domain_count", "average_score", "premium", "ready", "usable", "incomplete"],
      "properties": {
        "tool_count": { "type": "integer", "minimum": 0 }, "domain_count": { "type": "integer", "minimum": 0 },
        "average_score": { "type": "number", "minimum": 0, "maximum": 100 }, "premium": { "type": "integer", "minimum": 0 },
        "ready": { "type": "integer", "minimum": 0 }, "usable": { "type": "integer", "minimum": 0 }, "incomplete": { "type": "integer", "minimum": 0 }
      }
    },
    "domains": { "type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["name", "tools"],
      "properties": { "name": { "type": "string", "minLength": 1 }, "tools": { "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "title", "description", "risk_class", "scopes", "score", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 }, "name": { "type": "string", "minLength": 1 }, "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 }, "risk_class": { "type": "string", "pattern": "^R[0-5]$" },
          "scopes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "score": { "type": "number", "minimum": 0, "maximum": 100 },
          "status": { "enum": ["incomplete", "needs_improvement", "usable", "ready", "premium"] }
        }
      } } }
    } }
  }
}

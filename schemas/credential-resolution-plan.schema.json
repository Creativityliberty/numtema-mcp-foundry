{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.numtema.dev/foundry/credential-resolution-plan.schema.json",
  "title": "CredentialResolutionPlan",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "artifact_version", "dry_run", "binding_id", "binding_revision", "adapter_id", "adapter_revision", "tool_id", "tool_revision", "context_hash", "selected_credential", "checks", "scope_check", "audience_check", "tenant_check", "injection_envelope", "ready", "warnings", "errors", "integrity"],
  "properties": {
    "artifact_type": {"const": "credential_resolution_plan"},
    "artifact_version": {"const": "0.7"},
    "dry_run": {"const": true},
    "binding_id": {"type": "string"},
    "binding_revision": {"type": "string"},
    "adapter_id": {"type": "string"},
    "adapter_revision": {"type": "string"},
    "tool_id": {"type": "string"},
    "tool_revision": {"type": "string"},
    "context_hash": {"type": "string"},
    "selected_credential": {"type": ["object", "null"]},
    "checks": {"type": "array"},
    "scope_check": {"type": "object"},
    "audience_check": {"type": "object"},
    "tenant_check": {"type": "object"},
    "injection_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "location", "name", "prefix", "signing_algorithm", "credential_handle", "secret_material_included"],
      "properties": {
        "strategy": {"enum": ["none", "bearer_token", "api_key", "basic_auth", "hmac_signature", "host_managed"]},
        "location": {"enum": ["header", "query", "cookie", "runtime"]},
        "name": {"type": ["string", "null"]},
        "prefix": {"type": ["string", "null"]},
        "signing_algorithm": {"type": ["string", "null"]},
        "credential_handle": {"type": ["string", "null"]},
        "secret_material_included": {"const": false}
      }
    },
    "ready": {"type": "boolean"},
    "warnings": {"type": "array"},
    "errors": {"type": "array"},
    "integrity": {"type": "object", "required": ["algorithm", "digest"], "properties": {"algorithm": {"const": "sha256"}, "digest": {"type": "string"}}}
  }
}

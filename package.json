{
  "name": "@numtema/mcp-foundry",
  "version": "1.4.0",
  "private": false,
  "type": "module",
  "description": "OpenAPI-to-ChatGPT App Foundry with premium tool intelligence, quality scoring, OAuth 2.1, durable dispatch, Studio, and Coolify/VPS deployment.",
  "bin": { "foundry": "./dist/src/cli/foundry-1.4.js" },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && npm run bundle:json && node --test dist/tests/*.test.js",
    "validate:example": "node dist/src/cli/foundry-1.4.js validate examples/contract-bundle.yaml",
    "inspect:example": "node dist/src/cli/foundry-1.4.js inspect examples/openapi-reference.json",
    "map:example": "node dist/src/cli/foundry-1.4.js map examples/openapi-reference.json",
    "compile:example": "node dist/src/cli/foundry-1.4.js compile examples/capability-map.generated.json --out examples/contract-bundle.generated.json",
    "pipeline:schema-rich": "node dist/src/cli/foundry-1.4.js inspect examples/openapi-schema-rich.json --out examples/source-inspection.schema-rich.generated.json && node dist/src/cli/foundry-1.4.js map examples/openapi-schema-rich.json --out examples/capability-map.schema-rich.generated.json && node dist/src/cli/foundry-1.4.js compile examples/capability-map.schema-rich.generated.json --out examples/contract-bundle.schema-rich.generated.json && node dist/src/cli/foundry-1.4.js validate examples/contract-bundle.schema-rich.generated.json",
    "adapters:example": "node dist/src/cli/foundry-1.4.js adapters examples/contract-bundle.schema-rich.generated.json --out examples/provider-adapters.schema-rich.generated.json",
    "plan:customer-get": "node dist/src/cli/foundry-1.4.js plan examples/contract-bundle.schema-rich.generated.json --tool customer_get --base-url https://api.example.test/v1 --args examples/customer-get.arguments.json --out examples/provider-plan.customer-get.generated.json",
    "plan:customer-create": "node dist/src/cli/foundry-1.4.js plan examples/contract-bundle.schema-rich.generated.json --tool customer_create --base-url https://api.example.test/v1 --args examples/customer-create.arguments.json --out examples/provider-plan.customer-create.generated.json",
    "pipeline:provider": "npm run adapters:example && npm run plan:customer-get && npm run plan:customer-create",
    "bundle:json": "node scripts/build-json-bundle.mjs",
    "auth-bindings:example": "node dist/src/cli/foundry-1.4.js auth-bindings examples/contract-bundle.auth.generated.json --out examples/provider-auth-bindings.generated.json",
    "auth-plan:example": "node dist/src/cli/foundry-1.4.js auth-plan examples/contract-bundle.auth.generated.json --tool customer_get --credentials examples/credential-catalog.example.json --context examples/credential-context.example.json --out examples/credential-resolution-plan.generated.json",
    "pipeline:auth": "node dist/src/cli/foundry-1.4.js adapters examples/contract-bundle.auth.generated.json --out examples/provider-adapters.auth.generated.json && npm run auth-bindings:example && npm run auth-plan:example",
    "preflight:example": "node dist/src/cli/foundry-1.4.js preflight --execution-plan examples/runtime/provider-execution-plan.json --credential-plan examples/runtime/credential-resolution-plan.json --policy examples/runtime/runtime-policy-decision.json --approval examples/runtime/approval-proof.json --budget examples/runtime/budget-authorization.json --trust-store examples/runtime/runtime-trust-store.json --at 2026-07-22T16:01:00Z --out examples/runtime/authorized-execution-envelope.generated.json",
    "pipeline:runtime": "npm run preflight:example",
    "doctor": "node dist/src/cli/foundry-1.4.js doctor",
    "demo": "node dist/src/cli/foundry-1.4.js demo",
    "init:example": "node dist/src/cli/foundry-1.4.js init ./numtema-mcp-example --force",
    "pack:local": "npm pack --pack-destination ./release",
    "ledger:status": "node dist/src/cli/foundry-1.4.js ledger status --ledger examples/dispatch/ledger --json",
    "mcp:init:example": "node dist/src/cli/foundry-1.4.js mcp init ./numtema-mcp-runtime --force",
    "app:init:example": "node dist/src/cli/foundry-1.4.js app init ./numtema-chatgpt-app --force",
    "app:inspect:example": "node dist/src/cli/foundry-1.4.js app inspect --config ./numtema-chatgpt-app/chatgpt-app-config.json",
    "studio:init:example": "node dist/src/cli/foundry-1.4.js studio init ./numtema-foundry-studio --force",
    "studio:build:example": "node dist/src/cli/foundry-1.4.js studio build ./numtema-foundry-studio",
    "studio:serve:example": "node dist/src/cli/foundry-1.4.js studio serve ./numtema-foundry-studio --port 4173",
    "tools:audit": "node dist/src/cli/foundry-1.4.js tools audit examples/studio/project",
    "audit:secrets": "./scripts/audit-secrets.sh",
    "publish:github": "./scripts/publish-github.sh"
  },
  "engines": { "node": ">=22" },
  "devDependencies": { "typescript": "^5.8.3" },
  "license": "UNLICENSED",
  "files": [
    "dist/src/**/*.js", "dist/src/**/*.d.ts", "schemas/**/*.json", "examples/openapi-schema-rich.json",
    "scripts/install.sh", "scripts/install.ps1", "README.md", "CHANGELOG.md", "SOURCES.md", "MANIFEST.json",
    "docs/product/INSTALLATION_AND_FIRST_RUN.md", "docs/runtime/DURABLE_DISPATCH_AUTHORIZATION_LEDGER.md",
    "examples/contract-bundle.auth.generated.json", "examples/provider-adapters.auth.generated.json", "examples/provider-auth-bindings.generated.json",
    "examples/credential-catalog.example.json", "examples/customer-get.arguments.json", "docs/runtime/MCP_SERVER_RUNTIME.md",
    "docs/releases/verification/SPRINT_1.0_VERIFICATION.md", "examples/mcp/runtime-config.template.json",
    "examples/mcp/signed-execution-receipt.generated.json", "schemas/chatgpt-app-config.schema.json",
    "docs/apps/CHATGPT_APP_AND_OAUTH_GATEWAY.md", "docs/deployment/CHATGPT_APP_DEPLOYMENT.md",
    "docs/releases/verification/SPRINT_1.1_VERIFICATION.md", "examples/apps/chatgpt-app-config.template.json",
    "examples/apps/oauth-protected-resource.generated.json", "examples/apps/oauth-authorization-server.generated.json",
    "examples/apps/approval-widget.generated.html", "deploy/chatgpt-app/Dockerfile", "deploy/chatgpt-app/Caddyfile.example",
    "deploy/chatgpt-app/docker-compose.example.yml", "studio/index.html", "studio/assets/*.css", "studio/assets/*.js",
    "schemas/studio-project.schema.json", "schemas/deployment-package-manifest.schema.json", "docs/studio/FOUNDRY_STUDIO.md",
    "docs/deployment/COOLIFY_AND_VPS_ONE_CLICK.md", "docs/releases/verification/SPRINT_1.2_VERIFICATION.md",
    "examples/studio/**/*.json", "AGENTS.md", "CONTRIBUTING.md", "SECURITY.md",
    "docs/deployment/COOLIFY_CONFIGURATION.md", "docs/deployment/GITHUB_PUBLISHING.md",
    "docs/releases/verification/SPRINT_1.3_VERIFICATION.md", "scripts/audit-secrets.sh", "scripts/publish-github.sh",
    "docs/tools/TOOL_INTELLIGENCE_AND_QUALITY.md", "docs/releases/verification/SPRINT_1.4_VERIFICATION.md"
  ],
  "keywords": ["mcp", "openapi", "chatgpt", "agentic", "tools", "oauth", "governance"]
}

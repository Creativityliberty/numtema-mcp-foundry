{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://numtema.dev/schemas/provider-execution-plan.schema.json",
  "title": "ProviderExecutionPlan",
  "type": "object",
  "required": ["artifact_type", "artifact_version", "dry_run", "adapter_id", "adapter_revision", "tool_id", "tool_revision", "arguments_hash", "credential_requirement", "request", "idempotency", "response_plan", "warnings", "integrity"],
  "properties": {
    "artifact_type": { "const": "provider_execution_plan" },
    "artifact_version": { "const": "0.6" },
    "dry_run": { "const": true },
    "adapter_id": { "type": "string" },
    "adapter_revision": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "tool_id": { "type": "string" },
    "tool_revision": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "arguments_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "credential_requirement": {
      "type": "object",
      "required": ["auth_ref", "required_scopes", "secret_material_included"],
      "properties": {
        "auth_ref": { "type": ["string", "null"] },
        "required_scopes": { "type": "array", "items": { "type": "string" } },
        "secret_material_included": { "const": false }
      },
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "required": ["method", "url", "path", "query", "headers", "body"],
      "properties": {
        "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS", "TRACE"] },
        "url": { "type": "string", "format": "uri" },
        "path": { "type": "string" },
        "query": { "type": "array", "items": { "type": "object" } },
        "headers": { "type": "array", "items": { "type": "object" } },
        "body": { "type": ["object", "null"] }
      },
      "additionalProperties": false
    },
    "idempotency": {
      "type": "object",
      "required": ["mode", "header_name", "key_source", "key"],
      "properties": {
        "mode": { "enum": ["none", "optional", "required"] },
        "header_name": { "const": "Idempotency-Key" },
        "key_source": { "enum": ["none", "provided", "dry_run_generated"] },
        "key": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "response_plan": {
      "type": "object",
      "required": ["success_statuses", "error_statuses", "other_statuses"],
      "properties": {
        "success_statuses": { "type": "array", "items": { "type": "string" } },
        "error_statuses": { "type": "array", "items": { "type": "string" } },
        "other_statuses": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "warnings": { "type": "array", "items": { "type": "object" } },
    "integrity": {
      "type": "object",
      "required": ["algorithm", "digest"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

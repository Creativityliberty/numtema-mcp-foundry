{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.numtema.dev/foundry/tool-contract.schema.json",
  "title": "ToolContract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "description",
    "input_schema",
    "output_schema",
    "annotations",
    "effects",
    "execution",
    "required_scopes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 40
    },
    "input_schema": {
      "type": "object"
    },
    "output_schema": {
      "type": "object"
    },
    "annotations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read_only",
        "destructive",
        "idempotent",
        "open_world"
      ],
      "properties": {
        "read_only": {
          "type": "boolean"
        },
        "destructive": {
          "type": "boolean"
        },
        "idempotent": {
          "type": "boolean"
        },
        "open_world": {
          "type": "boolean"
        }
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "writes",
        "external_communication",
        "financial",
        "credential_change",
        "personal_data"
      ],
      "properties": {
        "writes": {
          "type": "boolean"
        },
        "external_communication": {
          "type": "boolean"
        },
        "financial": {
          "type": "boolean"
        },
        "credential_change": {
          "type": "boolean"
        },
        "personal_data": {
          "type": "boolean"
        },
        "reversible": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "task_support",
        "idempotency"
      ],
      "properties": {
        "mode": {
          "enum": [
            "synchronous",
            "asynchronous",
            "adaptive"
          ]
        },
        "task_support": {
          "enum": [
            "forbidden",
            "optional",
            "required"
          ]
        },
        "idempotency": {
          "enum": [
            "not_applicable",
            "unsupported",
            "supported",
            "required"
          ]
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "required_scopes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "policy_ref": {
      "type": "string"
    },
    "approval_ref": {
      "type": "string"
    },
    "recovery_ref": {
      "type": "string"
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    },
    "auth_ref": {
      "type": "string"
    }
  }
}

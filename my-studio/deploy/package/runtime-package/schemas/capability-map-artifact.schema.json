{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.numtema.local/foundry/capability-map-artifact-0.3.schema.json",
  "title": "CapabilityMapArtifact 0.3",
  "type": "object",
  "required": [
    "artifact_type",
    "artifact_version",
    "source_ref",
    "source_title",
    "domains",
    "capabilities",
    "workflow_hints",
    "summary",
    "limitations"
  ],
  "properties": {
    "artifact_type": {
      "const": "capability_map"
    },
    "artifact_version": {
      "const": "0.3"
    },
    "source_ref": {
      "type": "string",
      "minLength": 1
    },
    "source_title": {
      "type": "string",
      "minLength": 1
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "capability_names",
          "operation_count"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "capability_names": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "operation_count": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "title",
          "description",
          "source_operation_id",
          "domain",
          "method",
          "path",
          "risk_class",
          "governance",
          "required_scopes",
          "annotations",
          "execution",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^cap:"
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "source_operation_id": {
            "type": "string",
            "minLength": 1
          },
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "enum": [
              "get",
              "post",
              "put",
              "patch",
              "delete",
              "head",
              "options",
              "trace"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "risk_class": {
            "enum": [
              "R0",
              "R1",
              "R2",
              "R3",
              "R4",
              "R5"
            ]
          },
          "governance": {
            "type": "object",
            "required": [
              "decision",
              "approval_mode",
              "reasons"
            ],
            "properties": {
              "decision": {
                "enum": [
                  "allow",
                  "deny",
                  "require_scope",
                  "require_confirmation",
                  "require_widget",
                  "require_approver"
                ]
              },
              "approval_mode": {
                "enum": [
                  "none",
                  "chat_explicit",
                  "secure_widget",
                  "approver",
                  "dual_control"
                ]
              },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          },
          "required_scopes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "annotations": {
            "type": "object",
            "required": [
              "read_only",
              "destructive",
              "idempotent",
              "open_world"
            ],
            "properties": {
              "read_only": {
                "type": "boolean"
              },
              "destructive": {
                "type": "boolean"
              },
              "idempotent": {
                "type": "boolean"
              },
              "open_world": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          "execution": {
            "type": "object",
            "required": [
              "mode",
              "task_support",
              "idempotency"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "synchronous",
                  "asynchronous"
                ]
              },
              "task_support": {
                "enum": [
                  "forbidden",
                  "required"
                ]
              },
              "idempotency": {
                "enum": [
                  "not_applicable",
                  "supported",
                  "required"
                ]
              }
            },
            "additionalProperties": false
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "code",
                "message",
                "source"
              ],
              "properties": {
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "source": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "schema": {
            "type": "object",
            "required": [
              "parameters",
              "success_responses",
              "error_responses",
              "other_responses",
              "media",
              "pagination",
              "unresolved_refs"
            ],
            "properties": {
              "parameters": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "location",
                    "required",
                    "schema",
                    "deprecated"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "location": {
                      "enum": [
                        "path",
                        "query",
                        "header",
                        "cookie"
                      ]
                    },
                    "required": {
                      "type": "boolean"
                    },
                    "schema": {
                      "type": "object"
                    },
                    "description": {
                      "type": "string"
                    },
                    "deprecated": {
                      "type": "boolean"
                    },
                    "style": {
                      "type": "string"
                    },
                    "explode": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "request_body": {
                "type": "object",
                "required": [
                  "required",
                  "content"
                ],
                "properties": {
                  "required": {
                    "type": "boolean"
                  },
                  "content": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "media_type",
                        "schema"
                      ],
                      "properties": {
                        "media_type": {
                          "type": "string",
                          "minLength": 1
                        },
                        "schema": {
                          "type": "object"
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "description": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              },
              "success_responses": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "status",
                    "description",
                    "content",
                    "headers"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": {
                      "type": "string"
                    },
                    "content": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "media_type",
                          "schema"
                        ],
                        "properties": {
                          "media_type": {
                            "type": "string",
                            "minLength": 1
                          },
                          "schema": {
                            "type": "object"
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "headers": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "name",
                          "required",
                          "schema"
                        ],
                        "properties": {
                          "name": {
                            "type": "string",
                            "minLength": 1
                          },
                          "required": {
                            "type": "boolean"
                          },
                          "schema": {
                            "type": "object"
                          },
                          "description": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": false
                      }
                    }
                  },
                  "additionalProperties": false
                }
              },
              "error_responses": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "status",
                    "description",
                    "content",
                    "headers"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": {
                      "type": "string"
                    },
                    "content": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "media_type",
                          "schema"
                        ],
                        "properties": {
                          "media_type": {
                            "type": "string",
                            "minLength": 1
                          },
                          "schema": {
                            "type": "object"
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "headers": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "name",
                          "required",
                          "schema"
                        ],
                        "properties": {
                          "name": {
                            "type": "string",
                            "minLength": 1
                          },
                          "required": {
                            "type": "boolean"
                          },
                          "schema": {
                            "type": "object"
                          },
                          "description": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": false
                      }
                    }
                  },
                  "additionalProperties": false
                }
              },
              "other_responses": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "status",
                    "description",
                    "content",
                    "headers"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": {
                      "type": "string"
                    },
                    "content": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "media_type",
                          "schema"
                        ],
                        "properties": {
                          "media_type": {
                            "type": "string",
                            "minLength": 1
                          },
                          "schema": {
                            "type": "object"
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "headers": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "name",
                          "required",
                          "schema"
                        ],
                        "properties": {
                          "name": {
                            "type": "string",
                            "minLength": 1
                          },
                          "required": {
                            "type": "boolean"
                          },
                          "schema": {
                            "type": "object"
                          },
                          "description": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": false
                      }
                    }
                  },
                  "additionalProperties": false
                }
              },
              "media": {
                "type": "object",
                "required": [
                  "request_content_types",
                  "response_content_types",
                  "binary_request",
                  "binary_response"
                ],
                "properties": {
                  "request_content_types": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "response_content_types": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "binary_request": {
                    "type": "boolean"
                  },
                  "binary_response": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": false
              },
              "pagination": {
                "type": "object",
                "required": [
                  "style",
                  "request_parameters",
                  "response_fields"
                ],
                "properties": {
                  "style": {
                    "enum": [
                      "none",
                      "cursor",
                      "offset",
                      "page"
                    ]
                  },
                  "request_parameters": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "response_fields": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              },
              "unresolved_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "workflow_hints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "domain",
          "steps",
          "confidence",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^workflow:"
          },
          "kind": {
            "enum": [
              "async_create_status",
              "upload_confirm"
            ]
          },
          "domain": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "enum": [
              "medium",
              "high"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "capability_count",
        "workflow_hint_count",
        "risk_counts",
        "approval_required_count"
      ],
      "properties": {
        "capability_count": {
          "type": "integer",
          "minimum": 0
        },
        "workflow_hint_count": {
          "type": "integer",
          "minimum": 0
        },
        "risk_counts": {
          "type": "object",
          "required": [
            "R0",
            "R1",
            "R2",
            "R3",
            "R4",
            "R5"
          ],
          "properties": {
            "R0": {
              "type": "integer",
              "minimum": 0
            },
            "R1": {
              "type": "integer",
              "minimum": 0
            },
            "R2": {
              "type": "integer",
              "minimum": 0
            },
            "R3": {
              "type": "integer",
              "minimum": 0
            },
            "R4": {
              "type": "integer",
              "minimum": 0
            },
            "R5": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "approval_required_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
